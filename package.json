{
  "name": "dld-kit",
  "version": "0.9.0",
  "description": "Decision-Linked Development: record, link, and audit development decisions alongside code",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimutt/dld-kit.git"
  },
  "homepage": "https://github.com/jimutt/dld-kit#readme",
  "keywords": [
    "dld",
    "decision-records",
    "agent-skills",
    "cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "dld": "dist/dld.mjs"
  },
  "files": [
    "dist/dld.mjs",
    "skills/",
    "rules/"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.src.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "npm run test:unit && npm run test:cli && npm run test:bats",
    "test:unit": "bun test src",
    "test:cli": "npm run build && bun test tests/cli",
    "test:bats": "tests/run.sh",
    "check:pack": "node scripts/check-pack.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "@types/node": "20.19.43",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
